<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Inversiones · Registro privado</title>
<style>
  :root {
    --bg: #f6f7f5; --panel: #ffffff; --texto: #1d2521; --suave: #5f6b65;
    --linea: #dfe4e0; --acento: #1f6b4f; --pos: #1a7f4b; --neg: #b3382c; --campo: #fbfcfb;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #121815; --panel: #1a221e; --texto: #e8eeea; --suave: #9aa7a0;
      --linea: #2b3630; --acento: #5fbf98; --pos: #5fd394; --neg: #ef8b80; --campo: #141b17;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--texto);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; line-height: 1.5; }
  header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 12px; padding: 16px 20px; border-bottom: 1px solid var(--linea); background: var(--panel); }
  header h1 { margin: 0; font-size: 1.2rem; }
  header p { margin: 2px 0 0; color: var(--suave); font-size: .9rem; }
  nav { display: flex; gap: 10px; flex-wrap: wrap; }
  a.btn, button.btn { font: inherit; font-size: .9rem; cursor: pointer; display: inline-block;
    padding: 8px 14px; border-radius: 8px; border: 1px solid var(--linea);
    background: transparent; color: var(--texto); text-decoration: none; }
  button.principal { background: var(--acento); border-color: var(--acento); color: #fff; padding: 10px 18px; }
  button:disabled { opacity: .6; cursor: progress; }
  a.btn:hover, button.btn:hover { border-color: var(--acento); }
  :focus-visible { outline: 2px solid var(--acento); outline-offset: 2px; }
  main { max-width: 1100px; margin: 0 auto; padding: 20px; }
  [hidden] { display: none !important; }
  section.caja { background: var(--panel); border: 1px solid var(--linea); border-radius: 12px; padding: 18px; margin-bottom: 16px; }
  h2 { margin: 0 0 12px; font-size: 1.05rem; }
  .bloqueo { max-width: 460px; margin: 60px auto; text-align: center; }
  .bloqueo p { color: var(--suave); }
  input[type=password], input[type=text], input[type=date] {
    width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--linea);
    background: var(--campo); color: var(--texto); font: inherit; }
  label { display: block; font-size: .85rem; color: var(--suave); margin-bottom: 4px; }
  .fila { display: flex; gap: 10px; align-items: center; justify-content: center; margin-top: 12px; flex-wrap: wrap; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; }
  .kpi { border: 1px solid var(--linea); border-radius: 10px; padding: 12px 14px; }
  .kpi span { display: block; color: var(--suave); font-size: .82rem; }
  .kpi strong { font-size: 1.3rem; font-variant-numeric: tabular-nums; }
  .pos { color: var(--pos); } .neg { color: var(--neg); }
  .tabla-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .92rem; font-variant-numeric: tabular-nums; }
  th, td { padding: 8px 10px; text-align: right; border-bottom: 1px solid var(--linea); white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; }
  th { color: var(--suave); font-weight: 600; }
  #grafico { width: 100%; height: 170px; display: block; }
  .grid-form { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 12px; margin-bottom: 12px; }
  details { margin: 8px 0 14px; }
  summary { cursor: pointer; color: var(--acento); }
  .vista-previa { padding: 10px 12px; border: 1px dashed var(--linea); border-radius: 8px; margin: 12px 0; font-size: .92rem; }
  .msg { min-height: 1.3em; margin-top: 10px; font-size: .92rem; }
  .msg.error { color: var(--neg); } .msg.ok { color: var(--pos); }
  .nota { color: var(--suave); font-size: .85rem; }
</style>
</head>
<body>

<header>
  <div>
    <h1>Inversiones · registro privado</h1>
    <p>Lee y escribe en tu planilla a través de un puente con token</p>
  </div>
  <nav>
    <a class="btn" href="./index.html">Volver al hub</a>
    <a class="btn" href="./inversiones.html">Panel en Looker</a>
    <button class="btn" id="btn-ocultar" type="button" hidden>Ocultar</button>
    <button class="btn" id="btn-salir" type="button" hidden>Cerrar sesión</button>
  </nav>
</header>

<main>
  <!-- ===== BLOQUEO ===== -->
  <section class="caja bloqueo" id="vista-bloqueo">
    <h2>Acceso privado</h2>
    <p>Ingresa tu token para ver y registrar tus inversiones. No se guarda en el sitio ni en el repositorio.</p>
    <label for="token">Token</label>
    <input id="token" type="password" autocomplete="current-password" placeholder="Pega tu token">
    <div class="fila">
      <label style="margin:0"><input type="checkbox" id="recordar"> Recordar en este dispositivo</label>
      <button class="btn principal" id="btn-entrar" type="button">Entrar</button>
    </div>
    <div class="msg" id="msg-bloqueo" role="status"></div>
  </section>

  <!-- ===== APP ===== -->
  <div id="vista-app" hidden>

    <section class="caja">
      <h2>Estado del portafolio <span class="nota" id="ult-fecha"></span></h2>
      <div class="kpis" id="kpis"></div>
    </section>

    <section class="caja">
      <h2>Evolución del total</h2>
      <svg id="grafico" role="img" aria-label="Evolución semanal del total del portafolio"></svg>
      <p class="nota" id="nota-grafico"></p>
    </section>

    <section class="caja">
      <h2>Detalle por plataforma</h2>
      <div class="tabla-wrap">
        <table>
          <thead><tr><th>Plataforma</th><th>Saldo</th><th>Invertido</th><th>Ganancia</th><th>Retorno</th></tr></thead>
          <tbody id="detalle"></tbody>
        </table>
      </div>
    </section>

    <section class="caja">
      <h2>Registrar semana</h2>
      <div style="max-width:220px; margin-bottom:12px">
        <label for="fecha">Fecha del registro</label>
        <input type="date" id="fecha">
      </div>
      <p class="nota">Saldo actual que ves en cada app, en pesos.</p>
      <div class="grid-form" id="campos-saldos"></div>

      <details>
        <summary>Hice un aporte nuevo esta semana</summary>
        <p class="nota">El aporte se registra en la semana y también en la tabla de aportes de COSTO_BASE, así no lo anotas dos veces.</p>
        <div class="grid-form" id="campos-aportes"></div>
      </details>

      <div class="vista-previa" id="vista-previa">Completa los saldos para ver la variación real.</div>
      <button class="btn principal" id="btn-guardar" type="button">Guardar en la planilla</button>
      <div class="msg" id="msg-guardar" role="status"></div>
    </section>
  </div>
</main>

<script>
  // ===== CONFIGURACIÓN: pega aquí la URL de tu Web App de Apps Script (termina en /exec) =====
  const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxPQkaOi2bnP5-pu5gPvx_Y_cBhgtk6zdoMxoLkNwv-kStcYgVagLsrPeviD3Rvp9G8/exec";
  const MINUTOS_INACTIVIDAD = 5;
  // ==========================================================================================

  const CLP = new Intl.NumberFormat("es-CL", { style: "currency", currency: "CLP", maximumFractionDigits: 0 });
  const PCT = new Intl.NumberFormat("es-CL", { style: "percent", minimumFractionDigits: 1, maximumFractionDigits: 1 });
  const $ = id => document.getElementById(id);

  let token = "";
  let datos = null;       // último resumen recibido
  let temporizador;

  // ---------- utilidades ----------
  const signo = n => (n > 0 ? "+" : n < 0 ? "−" : "");
  const clp = n => signo(n) + CLP.format(Math.abs(n));
  const pct = n => signo(n) + PCT.format(Math.abs(n));
  const clase = n => (n > 0 ? "pos" : n < 0 ? "neg" : "");
  const num = v => Number(String(v).replace(/[^\d]/g, "")) || 0;
  const hoyLocal = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
  function mostrarMsg(id, texto, tipo) { const el = $(id); el.textContent = texto || ""; el.className = "msg " + (tipo || ""); }

  async function llamar(accion, extra) {
    if (SCRIPT_URL.startsWith("PEGA_AQUI")) throw new Error("Falta configurar SCRIPT_URL en el archivo.");
    // Texto plano: evita el preflight CORS que Apps Script no responde
    const res = await fetch(SCRIPT_URL, { method: "POST", body: JSON.stringify(Object.assign({ accion, token }, extra)) });
    const json = await res.json();
    if (!json.ok) throw new Error(json.error || "Error desconocido");
    return json;
  }

  // ---------- sesión / bloqueo ----------
  function guardarToken(recordar) {
    (recordar ? localStorage : sessionStorage).setItem("inv_token", token);
    (recordar ? sessionStorage : localStorage).removeItem("inv_token");
  }
  function leerToken() {
    try { return localStorage.getItem("inv_token") || sessionStorage.getItem("inv_token") || ""; } catch (e) { return ""; }
  }
  function bloquear(borrarToken) {
    clearTimeout(temporizador);
    datos = null;
    ["kpis", "detalle", "campos-saldos", "campos-aportes"].forEach(id => $(id).replaceChildren());
    $("grafico").replaceChildren();
    $("vista-app").hidden = true;
    $("btn-ocultar").hidden = true;
    $("btn-salir").hidden = true;
    $("vista-bloqueo").hidden = false;
    if (borrarToken) {
      try { localStorage.removeItem("inv_token"); sessionStorage.removeItem("inv_token"); } catch (e) {}
      token = ""; $("token").value = "";
    } else { $("token").value = ""; }
  }
  function reiniciarTemporizador() {
    clearTimeout(temporizador);
    temporizador = setTimeout(() => bloquear(false), MINUTOS_INACTIVIDAD * 60 * 1000);
  }

  async function entrar() {
    const t = $("token").value.trim() || leerToken();
    if (!t) { mostrarMsg("msg-bloqueo", "Ingresa tu token.", "error"); return; }
    token = t;
    $("btn-entrar").disabled = true;
    mostrarMsg("msg-bloqueo", "Verificando…");
    try {
      const r = await llamar("resumen");
      guardarToken($("recordar").checked || !!localStorage.getItem("inv_token"));
      mostrarMsg("msg-bloqueo", "");
      abrirApp(r);
    } catch (e) {
      token = "";
      mostrarMsg("msg-bloqueo", e.message + " · Si el mensaje es de red, revisa la implementación del Web App.", "error");
    } finally { $("btn-entrar").disabled = false; }
  }

  function abrirApp(r) {
    $("vista-bloqueo").hidden = true;
    $("vista-app").hidden = false;
    $("btn-ocultar").hidden = false;
    $("btn-salir").hidden = false;
    pintar(r);
    reiniciarTemporizador();
  }

  // ---------- pintar datos ----------
  function celda(tr, texto, cls) { const td = document.createElement("td"); td.textContent = texto; if (cls) td.className = cls; tr.appendChild(td); }

  function pintar(r) {
    datos = r;
    // KPIs
    const k = r.kpi;
    const kp = $("kpis"); kp.replaceChildren();
    const tarjetas = k ? [
      ["Total hoy", CLP.format(k.total), ""],
      ["Total invertido", CLP.format(k.invertido), ""],
      ["Ganancia real (costo base)", clp(k.ganancia) + " · " + pct(k.retorno), clase(k.ganancia)],
      ["Desde " + k.desdeSeguimiento.fechaInicio, clp(k.desdeSeguimiento.ganancia) + " · " + pct(k.desdeSeguimiento.retorno), clase(k.desdeSeguimiento.ganancia)],
      ["Semanas registradas", String(k.semanas), ""]
    ] : [["Sin registros todavía", "Registra tu primera semana abajo", ""]];
    tarjetas.forEach(([t, v, c]) => {
      const d = document.createElement("div"); d.className = "kpi";
      const s = document.createElement("span"); s.textContent = t;
      const b = document.createElement("strong"); b.textContent = v; if (c) b.className = c;
      d.append(s, b); kp.appendChild(d);
    });
    $("ult-fecha").textContent = r.ultima ? "· último registro " + r.ultima.fecha : "";

    // Detalle
    const tb = $("detalle"); tb.replaceChildren();
    (r.detalle || []).forEach(x => {
      const tr = document.createElement("tr");
      celda(tr, x.plataforma); celda(tr, CLP.format(x.saldo)); celda(tr, CLP.format(x.invertido));
      celda(tr, clp(x.ganancia), clase(x.ganancia)); celda(tr, pct(x.retorno), clase(x.ganancia));
      tb.appendChild(tr);
    });

    graficar(r.serie || []);
    construirFormulario(r);
  }

  function graficar(serie) {
    const svg = $("grafico"); svg.replaceChildren();
    $("nota-grafico").textContent = serie.length < 2 ? "Se necesitan al menos 2 registros para dibujar la curva." : "";
    if (serie.length < 2) return;
    const W = 800, H = 170, m = { l: 8, r: 8, t: 12, b: 22 };
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
    const vals = serie.map(s => s.total), min = Math.min(...vals), max = Math.max(...vals);
    const rango = max - min || 1;
    const x = i => m.l + i * (W - m.l - m.r) / (serie.length - 1);
    const y = v => m.t + (1 - (v - min) / rango) * (H - m.t - m.b);
    const NS = "http://www.w3.org/2000/svg";
    const linea = document.createElementNS(NS, "polyline");
    linea.setAttribute("points", serie.map((s, i) => `${x(i)},${y(s.total)}`).join(" "));
    linea.setAttribute("fill", "none"); linea.setAttribute("stroke", "var(--acento)"); linea.setAttribute("stroke-width", "2.5");
    svg.appendChild(linea);
    serie.forEach((s, i) => {
      const c = document.createElementNS(NS, "circle");
      c.setAttribute("cx", x(i)); c.setAttribute("cy", y(s.total)); c.setAttribute("r", 3.5); c.setAttribute("fill", "var(--acento)");
      const t = document.createElementNS(NS, "title"); t.textContent = s.fecha + " · " + CLP.format(s.total);
      c.appendChild(t); svg.appendChild(c);
    });
    [[0, "start"], [serie.length - 1, "end"]].forEach(([i, anchor]) => {
      const tx = document.createElementNS(NS, "text");
      tx.setAttribute("x", x(i)); tx.setAttribute("y", H - 5); tx.setAttribute("text-anchor", anchor);
      tx.setAttribute("fill", "var(--suave)"); tx.setAttribute("font-size", "12"); tx.textContent = serie[i].fecha;
      svg.appendChild(tx);
    });
  }

  // ---------- formulario ----------
  function campo(contenedor, prefijo, nombre, i) {
    const d = document.createElement("div");
    const l = document.createElement("label"); l.htmlFor = prefijo + i; l.textContent = nombre;
    const inp = document.createElement("input");
    inp.type = "text"; inp.inputMode = "numeric"; inp.id = prefijo + i; inp.placeholder = "0"; inp.autocomplete = "off";
    inp.addEventListener("input", vistaPrevia);
    d.append(l, inp); contenedor.appendChild(d);
  }
  function construirFormulario(r) {
    $("campos-saldos").replaceChildren(); $("campos-aportes").replaceChildren();
    r.plataformas.forEach((p, i) => { campo($("campos-saldos"), "saldo", p, i); campo($("campos-aportes"), "aporte", "Aporte a " + p, i); });
    $("fecha").value = hoyLocal();
    vistaPrevia();
  }
  function leerForm() {
    const n = datos.plataformas.length;
    const saldos = [], aportes = [];
    for (let i = 0; i < n; i++) { saldos.push(num($("saldo" + i).value)); aportes.push(num($("aporte" + i).value)); }
    return { saldos, aportes, fecha: $("fecha").value };
  }
  function vistaPrevia() {
    if (!datos) return;
    const { saldos, aportes } = leerForm();
    const total = saldos.reduce((a, b) => a + b, 0), ap = aportes.reduce((a, b) => a + b, 0);
    const box = $("vista-previa");
    if (!total) { box.textContent = "Completa los saldos para ver la variación real."; return; }
    if (!datos.ultima) { box.textContent = "Total del registro: " + CLP.format(total) + " (primer registro)."; return; }
    const bruta = total - datos.ultima.total, real = bruta - ap;
    box.textContent = `Total: ${CLP.format(total)} · Var. bruta: ${clp(bruta)} · Aportes: ${CLP.format(ap)} · Var. real estimada: ${clp(real)}`;
  }

  async function guardar() {
    const f = leerForm();
    if (!f.fecha) { mostrarMsg("msg-guardar", "Elige una fecha.", "error"); return; }
    if (f.saldos.some(s => s === 0)) {
      if (!confirm("Hay plataformas con saldo 0. ¿Guardar igual?")) return;
    }
    const total = f.saldos.reduce((a, b) => a + b, 0), ap = f.aportes.reduce((a, b) => a + b, 0);
    if (!confirm(`Guardar registro del ${f.fecha}\nTotal: ${CLP.format(total)}\nAportes: ${CLP.format(ap)}`)) return;

    $("btn-guardar").disabled = true;
    mostrarMsg("msg-guardar", "Guardando…");
    try {
      const r = await llamar("registrar_semana", f);
      mostrarMsg("msg-guardar", "Guardado en la fila " + r.fila + (r.aportesRegistrados ? " · aportes registrados: " + r.aportesRegistrados : "") + ".", "ok");
      pintar(r.resumen);
    } catch (e) {
      mostrarMsg("msg-guardar", e.message, "error");
    } finally { $("btn-guardar").disabled = false; }
  }

  // ---------- eventos ----------
  $("btn-entrar").addEventListener("click", entrar);
  $("token").addEventListener("keydown", e => { if (e.key === "Enter") entrar(); });
  $("btn-guardar").addEventListener("click", guardar);
  $("btn-ocultar").addEventListener("click", () => bloquear(false));
  $("btn-salir").addEventListener("click", () => bloquear(true));
  ["mousemove", "keydown", "touchstart", "scroll"].forEach(ev =>
    document.addEventListener(ev, () => { if (datos) reiniciarTemporizador(); }, { passive: true }));
  document.addEventListener("visibilitychange", () => { if (document.hidden && datos) bloquear(false); });

  // Si hay token recordado, precarga el campo para entrar con un clic
  if (leerToken()) { $("token").placeholder = "Token guardado en este dispositivo · pulsa Entrar"; }
</script>
</body>
</html>
